# ============================================================================
# Biến môi trường của Recommendation Service
# ============================================================================
# Sao chép file này thành .env khi chạy local.
# Không commit .env, password, token hoặc API key thật lên Git.
# Khi chạy Docker Compose/Kubernetes, thay localhost bằng hostname của service.

# ----------------------------------------------------------------------------
# 01. Runtime - HTTP API và log TypeORM
# ----------------------------------------------------------------------------
NODE_ENV=development                         # development | production
PORT=3006                                     # Port HTTP của Recommendation Service
APP_VERSION=1.0.0                             # Version trả về trong health endpoint
TYPEORM_LOGGING=false                         # Bật log SQL khi cần debug

# ----------------------------------------------------------------------------
# 02. PostgreSQL - dữ liệu gốc do Recommendation Service sở hữu
# ----------------------------------------------------------------------------
POSTGRES_HOST=localhost                       # Host PostgreSQL khi chạy local
POSTGRES_PORT=5432                            # Port PostgreSQL
POSTGRES_USER=bin_ecommerce                   # User kết nối database
POSTGRES_PASSWORD=
POSTGRES_DB=bin_ecommerce_recommendation     # Tên database recommendation

# ----------------------------------------------------------------------------
# 03. Kafka - interaction, catalog, purchase và embedding event
# ----------------------------------------------------------------------------
KAFKA_BROKERS=localhost:29092                # Danh sách broker, phân tách bằng dấu phẩy
KAFKA_CLIENT_ID=recommendation-service       # Định danh Kafka client
KAFKA_CONSUMER_GROUP=recommendation-interactions-v1 # Consumer group chính
KAFKA_RECONNECT_DELAY_MS=5000                # Thời gian chờ trước khi kết nối lại
KAFKA_RETRY_BASE_DELAY_MS=250                # Delay retry ban đầu khi xử lý event
KAFKA_RETRY_MAX_DELAY_MS=5000                # Delay retry tối đa

# ----------------------------------------------------------------------------
# 04. Redis - session context và recommendation cache có version
# ----------------------------------------------------------------------------
REDIS_HOST=localhost                          # Host Redis khi chạy local
REDIS_PORT=6379                               # Port Redis
REDIS_PASSWORD=
REDIS_DB=1                                    # Logical database riêng cho recommendation
RECOMMENDATION_CACHE_TTL_SECONDS=300          # TTL cache kết quả, tối đa 30 phút theo code
RECOMMENDATION_SESSION_TTL_SECONDS=86400      # TTL session context, tối đa 7 ngày theo code
RECOMMENDATION_SESSION_MAX_RECENT_ITEMS=30    # Số sản phẩm gần đây lưu cho mỗi session

# ----------------------------------------------------------------------------
# 05. Catalog bootstrap - nạp read model một lần từ Product Service
# ----------------------------------------------------------------------------
# Request recommendation không gọi Product Service trực tiếp để đọc catalog.
PRODUCT_SERVICE_URL=http://localhost:3008     # URL Product Service nội bộ
AUTH_SERVICE_URL=http://localhost:3002        # URL Auth Service khi cần đồng bộ account
INTERNAL_SERVICE_TOKEN=
CATALOG_BOOTSTRAP=false                       # Chỉ bật true khi cần backfill catalog
CATALOG_BOOTSTRAP_TIMEOUT_MS=10000            # Timeout cho một request catalog page
CATALOG_BOOTSTRAP_RESET=false                 # Bắt đầu lại từ page 1 thay vì checkpoint
CATALOG_BOOTSTRAP_RETRY_MS=30000              # Thời gian retry khi Product Service chưa sẵn sàng

# ----------------------------------------------------------------------------
# 06. Candidate và embedding pipeline
# ----------------------------------------------------------------------------
# Các source vẫn được thu thập đầy đủ; mỗi source fail-soft khi dependency lỗi.
# Ba ENV master switch chỉ dành cho vận hành khẩn cấp, không phải quyền cấu hình Admin.
CANDIDATE_PIPELINE_V3_ENABLED=true            # Master switch cho candidate pipeline
SEMANTIC_CANDIDATES_ENABLED=true              # Cho phép candidate từ Qdrant semantic search
CO_BEHAVIOR_CANDIDATES_ENABLED=true           # Cho phép candidate từ hành vi liên quan

EMBEDDING_DISPATCHER_ENABLED=true             # Phát durable job sang AI Service
EMBEDDING_DISPATCH_INTERVAL_MS=1000           # Chu kỳ quét job embedding
EMBEDDING_DISPATCH_BATCH_SIZE=20              # Số job tối đa mỗi lần publish
EMBEDDING_JOB_LEASE_SECONDS=120               # Thời gian lease chống dispatch trùng
EMBEDDING_JOB_ACK_TIMEOUT_SECONDS=300         # Chờ generated event trước khi dispatch lại
EMBEDDING_JOB_MAX_ATTEMPTS=8                  # Số lần thử tối đa trước khi chuyển FAILED
EMBEDDING_MODEL=text-embedding-3-small        # Tên model embedding của provider
EMBEDDING_MODEL_VERSION=text-embedding-3-small # Version được lưu cùng vector

QDRANT_URL=http://localhost:6333              # HTTP endpoint của Qdrant
QDRANT_COLLECTION_ALIAS=recommendation_product_embeddings_current # Alias collection đang dùng
QDRANT_COLLECTION_VERSION=1                   # Version collection vật lý
QDRANT_ALIAS_PROMOTION_ENABLED=false          # Chỉ promote sau khi kiểm tra coverage/backfill
QDRANT_VECTOR_SIZE=1536                       # Phải khớp số chiều embedding
QDRANT_DISTANCE=Cosine                        # Cosine | Dot | Euclid
QDRANT_TIMEOUT_MS=500                         # Timeout request; lỗi sẽ fail-soft
QDRANT_INIT_RETRY_MS=5000                     # Delay retry khởi tạo collection/alias

RECOMMENDATION_RELATION_CO_VIEW_WEIGHT=1      # Trọng số quan hệ cùng xem
RECOMMENDATION_RELATION_CO_CLICK_WEIGHT=2     # Trọng số quan hệ cùng click
RECOMMENDATION_RELATION_CO_IMPRESSION_WEIGHT=0.05 # Impression thụ động có trọng số thấp
RECOMMENDATION_RELATION_CO_CART_WEIGHT=3      # Trọng số quan hệ cùng thêm giỏ
RECOMMENDATION_RELATION_CO_PURCHASE_WEIGHT=6  # Trọng số quan hệ cùng mua
RELATION_SCORE_HALF_LIFE_DAYS=30              # Chu kỳ giảm một nửa điểm quan hệ

# Tương thích ngược với tên biến relation cũ; chỉ dùng khi chạy service ngoài Compose.
RELATION_CO_VIEW_WEIGHT=1                     # Alias cũ của trọng số cùng xem
RELATION_CO_CLICK_WEIGHT=2                    # Alias cũ của trọng số cùng click
RELATION_CO_IMPRESSION_WEIGHT=0.05            # Alias cũ của trọng số impression
RELATION_CO_CART_WEIGHT=3                     # Alias cũ của trọng số thêm giỏ
RELATION_CO_PURCHASE_WEIGHT=6                 # Alias cũ của trọng số mua

# ----------------------------------------------------------------------------
# 07. Profile signal và Standard Ranking
# ----------------------------------------------------------------------------
RECOMMENDATION_RULE_VERSION=standard-ranking-v1 # Version rule Standard Ranking
RECOMMENDATION_PROFILE_HALF_LIFE_DAYS=7       # Chu kỳ giảm một nửa sở thích người dùng
RECOMMENDATION_WEIGHT_PRODUCT_IMPRESSED=0.05  # Trọng số impression thụ động
RECOMMENDATION_WEIGHT_PRODUCT_VIEWED=1        # Trọng số xem sản phẩm
RECOMMENDATION_WEIGHT_PRODUCT_CLICKED=2       # Trọng số click sản phẩm
RECOMMENDATION_WEIGHT_SEARCH_PERFORMED=1.5    # Trọng số thao tác tìm kiếm
RECOMMENDATION_WEIGHT_PRODUCT_ADDED_TO_CART=4 # Trọng số thêm vào giỏ
RECOMMENDATION_WEIGHT_PRODUCT_REMOVED_FROM_CART=-2 # Tín hiệu xóa khỏi giỏ
RECOMMENDATION_WEIGHT_PURCHASE_COMPLETED=8    # Trọng số mua thành công
RECOMMENDATION_WEIGHT_PURCHASE_RETURNED=-8    # Tín hiệu trả/refund sản phẩm

# ----------------------------------------------------------------------------
# 08. Analytics và policy ranking
# ----------------------------------------------------------------------------
RECOMMENDATION_TRACKING_SECRET=
RECOMMENDATION_RANKING_POLICY_VERSION=standard-ranking-v1 # Version policy Standard

# ----------------------------------------------------------------------------
# 09. AI-Enhanced Ranking
# ----------------------------------------------------------------------------
# Khi bật, AI được gọi cho toàn bộ request; lỗi/timeout sẽ fallback về Standard Ranking.
# Không còn cấu hình chia traffic hoặc assignment A/B trong environment.
AI_SERVICE_URL=http://localhost:3009             # URL AI Service nội bộ
ML_RANKING_ENABLED=true # Bật AI sau khi model health đã đạt
ML_RANKING_BLEND=0.3                             # Tỷ lệ ảnh hưởng AI, code giới hạn [0, 0.5]
ML_RANKING_POLICY_VERSION=ml-hybrid-v1           # Version dùng cho cache/trace AI
ML_RANKING_TIMEOUT_MS=150                        # Ngân sách request; timeout sẽ fallback
RECOMMENDATION_POLICY_SYNC_INTERVAL_MS=30000     # Chu kỳ đồng bộ policy giữa các instance

RECOMMENDATION_HYBRID_RANKING_WEIGHT_PROFILE_AFFINITY=0.25 # Sở thích sản phẩm
RECOMMENDATION_HYBRID_RANKING_WEIGHT_SESSION_CONTEXT=0.18   # Ngữ cảnh session
RECOMMENDATION_HYBRID_RANKING_WEIGHT_SEMANTIC_SIMILARITY=0.15 # Tương đồng semantic
RECOMMENDATION_HYBRID_RANKING_WEIGHT_CO_BEHAVIOR=0.1         # Hành vi liên quan
RECOMMENDATION_HYBRID_RANKING_WEIGHT_POPULARITY=0.12        # Độ phổ biến
RECOMMENDATION_HYBRID_RANKING_WEIGHT_FRESHNESS=0.08          # Độ mới
RECOMMENDATION_HYBRID_RANKING_WEIGHT_QUALITY=0.08            # Chất lượng
RECOMMENDATION_HYBRID_RANKING_WEIGHT_EXPLORATION=0.04       # Khám phá sản phẩm mới

# Scale chuẩn hóa raw relation score trước khi đưa vào ranking.
RECOMMENDATION_RELATION_SCALE_CO_VIEW=1
RECOMMENDATION_RELATION_SCALE_CO_CART=3
RECOMMENDATION_RELATION_SCALE_CO_PURCHASE=6

# ----------------------------------------------------------------------------
# 10. Maintenance - retention và replay job
# ----------------------------------------------------------------------------
# Raw event giữ 90 ngày; aggregate giữ 365 ngày. Bật retention sau khi đã kiểm tra production.
RECOMMENDATION_RETENTION_ENABLED=false         # Tắt local để không xóa dữ liệu developer
RECOMMENDATION_RETENTION_INTERVAL_MS=86400000  # Chu kỳ chạy retention
RECOMMENDATION_RAW_RETENTION_DAYS=90            # Số ngày giữ raw event
RECOMMENDATION_AGGREGATE_RETENTION_DAYS=365    # Số ngày giữ aggregate
RECOMMENDATION_RETENTION_BATCH_SIZE=1000        # Số bản ghi xử lý mỗi batch
RECOMMENDATION_RELATION_SAFETY_DAYS=7           # Khoảng an toàn cho relation aggregate
RECOMMENDATION_EMBEDDING_JOB_RETENTION_DAYS=90  # Số ngày giữ embedding job
RECOMMENDATION_REPLAY_JOB_RETENTION_DAYS=30     # Số ngày giữ replay job
REPLAY_MAX_ATTEMPTS=5                           # Số lần replay tối đa
