# ============================================================
# Recommendation Service Environment
# ============================================================
# Copy this file to services/recommendation-service/.env for local runs.
# Production secrets must be injected by the deployment platform.
# ============================================================

NODE_ENV=development
PORT=3006
APP_VERSION=1.0.0
TYPEORM_LOGGING=false

# PostgreSQL - database owned by Recommendation Service.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=bin_ecommerce
POSTGRES_PASSWORD=changeme_postgres
POSTGRES_DB=bin_ecommerce_recommendation

# Kafka carries interaction, catalog and purchase events for profile projection.
KAFKA_BROKERS=localhost:29092
KAFKA_CLIENT_ID=recommendation-service
KAFKA_CONSUMER_GROUP=recommendation-interactions-v1

# Redis - session intent and recommendation result cache.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=1

# Product Service is used only by the one-time catalog bootstrap job, never by serving queries.
PRODUCT_SERVICE_URL=http://localhost:3008
INTERNAL_SERVICE_TOKEN=replace-with-a-private-bootstrap-token
CATALOG_BOOTSTRAP=false
CATALOG_BOOTSTRAP_TIMEOUT_MS=10000
CATALOG_BOOTSTRAP_RESET=false

# Phase 3 semantic/vector pipeline. Tắt mặc định để rollout không đổi ranking Phase 2.
CANDIDATE_PIPELINE_V3_ENABLED=false
SEMANTIC_CANDIDATES_ENABLED=false
CO_BEHAVIOR_CANDIDATES_ENABLED=false
EMBEDDING_DISPATCHER_ENABLED=true
EMBEDDING_DISPATCH_INTERVAL_MS=1000
EMBEDDING_DISPATCH_BATCH_SIZE=20
EMBEDDING_JOB_LEASE_SECONDS=120
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_MODEL_VERSION=text-embedding-3-small
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION_ALIAS=recommendation_product_embeddings_current
QDRANT_COLLECTION_VERSION=1
QDRANT_VECTOR_SIZE=1536
QDRANT_DISTANCE=Cosine
QDRANT_TIMEOUT_MS=500
RELATION_CO_PURCHASE_WEIGHT=6
RELATION_CO_VIEW_WEIGHT=1
RELATION_CO_CART_WEIGHT=3
RELATION_SCORE_HALF_LIFE_DAYS=30

# Recommendation ranking policy. Values are versioned so rule changes can be traced in responses.
RECOMMENDATION_RULE_VERSION=phase2-rule-v2
RECOMMENDATION_PROFILE_HALF_LIFE_DAYS=7
RECOMMENDATION_WEIGHT_PRODUCT_IMPRESSED=0.05
RECOMMENDATION_WEIGHT_PRODUCT_VIEWED=1
RECOMMENDATION_WEIGHT_PRODUCT_CLICKED=2
RECOMMENDATION_WEIGHT_SEARCH_PERFORMED=1.5
RECOMMENDATION_WEIGHT_PRODUCT_ADDED_TO_CART=4
RECOMMENDATION_WEIGHT_PRODUCT_REMOVED_FROM_CART=-2
RECOMMENDATION_RANKING_WEIGHT_PROFILE_AFFINITY=0.35
RECOMMENDATION_RANKING_WEIGHT_SESSION_CONTEXT=0.2
RECOMMENDATION_RANKING_WEIGHT_POPULARITY=0.15
RECOMMENDATION_RANKING_WEIGHT_FRESHNESS=0.1
RECOMMENDATION_RANKING_WEIGHT_QUALITY=0.1
RECOMMENDATION_RANKING_WEIGHT_EXPLORATION=0.1
