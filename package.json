{
    "name": "@bin-ecommerce/recommendation-service",
    "version": "1.0.0",
    "private": true,
    "scripts": {
        "build": "nest build && tsc-alias -p tsconfig.build.json",
        "start": "node --max-old-space-size=128 dist/services/recommendation-service/src/main.js",
        "dev": "nest start --watch",
        "ranking-simulate": "node dist/services/recommendation-service/src/scripts/generate-ranking-synthetic-dataset.js",
        "ranking-session-context-evaluate": "npm run build && node dist/services/recommendation-service/src/scripts/evaluate-session-context-formulas.js",
        "ranking-criterion-3-semantic-evaluate": "npm run build && node dist/services/recommendation-service/src/scripts/evaluate-criterion-3-semantic.js",
        "ranking-criterion-4-cobehavior-evaluate": "npm run build && node dist/services/recommendation-service/src/scripts/evaluate-criterion-4-cobehavior.js",
        "ranking-criterion-5-popularity-evaluate": "npm run build && node dist/services/recommendation-service/src/scripts/evaluate-criterion-5-popularity.js",
        "ranking-criterion-6-freshness-evaluate": "npm run build && node dist/services/recommendation-service/src/scripts/evaluate-criterion-6-freshness.js",
        "ranking-criterion-7-quality-evaluate": "npm run build && node dist/services/recommendation-service/src/scripts/evaluate-criterion-7-quality.js",
        "ranking-criterion-8-exploration-evaluate": "npm run build && node dist/services/recommendation-service/src/scripts/evaluate-criterion-8-exploration.js",
        "ranking-criteria-3-8-evaluate": "npm run build && node dist/services/recommendation-service/src/scripts/evaluate-criterion-3-semantic.js && node dist/services/recommendation-service/src/scripts/evaluate-criterion-4-cobehavior.js && node dist/services/recommendation-service/src/scripts/evaluate-criterion-5-popularity.js && node dist/services/recommendation-service/src/scripts/evaluate-criterion-6-freshness.js && node dist/services/recommendation-service/src/scripts/evaluate-criterion-7-quality.js && node dist/services/recommendation-service/src/scripts/evaluate-criterion-8-exploration.js",
        "lint": "eslint src --ext .ts",
        "type-check": "tsc --noEmit",
        "test": "jest --passWithNoTests"
    },
    "dependencies": {
        "@nestjs/common": "^11.0.7",
        "@nestjs/config": "^4.0.1",
        "@nestjs/core": "^11.0.7",
        "@nestjs/platform-express": "^11.0.7",
        "@nestjs/swagger": "^11.1.0",
        "@nestjs/typeorm": "^11.0.0",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.14.1",
        "helmet": "^8.1.0",
        "ioredis": "^5.10.1",
        "kafkajs": "^2.2.4",
        "pg": "^8.13.3",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.2",
        "typeorm": "^0.3.22"
    },
    "devDependencies": {
        "@nestjs/cli": "^11.0.5",
        "@nestjs/testing": "^11.0.7",
        "@types/express": "^5.0.1",
        "@types/jest": "^29.5.14",
        "@types/node": "^22.10.7",
        "@types/pg": "^8.11.10",
        "jest": "^29.7.0",
        "ts-jest": "^29.2.5",
        "tsc-alias": "^1.9.4",
        "typescript": "^5.7.3"
    }
}
