# Recommendation Service environment template
# Copy to .env for local development. Do not commit .env or real secrets.

# ─────────────────────────────────────────────────────────────────────────────
# Runtime
# ─────────────────────────────────────────────────────────────────────────────
NODE_ENV=development                         # development | production
PORT=3006                                     # HTTP port of Recommendation Service
APP_VERSION=1.0.0                             # Version exposed by health endpoint
TYPEORM_LOGGING=false                         # Enable SQL logs only when debugging

# ─────────────────────────────────────────────────────────────────────────────
# PostgreSQL - source of truth owned by Recommendation Service
# ─────────────────────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost                       # PostgreSQL hostname
POSTGRES_PORT=5432                            # PostgreSQL port
POSTGRES_USER=bin_ecommerce                   # Database user
POSTGRES_PASSWORD=change-me                  # Database password
POSTGRES_DB=bin_ecommerce_recommendation     # Recommendation database name

# ─────────────────────────────────────────────────────────────────────────────
# Kafka - interactions, catalog, purchase and embedding events
# ─────────────────────────────────────────────────────────────────────────────
KAFKA_BROKERS=localhost:29092                # Comma-separated broker list
KAFKA_CLIENT_ID=recommendation-service       # Kafka client identifier
KAFKA_CONSUMER_GROUP=recommendation-interactions-v1 # Main interaction/profile group
KAFKA_RECONNECT_DELAY_MS=5000                # Delay before reconnecting a consumer

# ─────────────────────────────────────────────────────────────────────────────
# Redis - session context and versioned recommendation cache
# ─────────────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost                          # Redis hostname
REDIS_PORT=6379                               # Redis port
REDIS_PASSWORD=                               # Empty for local Redis without auth
REDIS_DB=1                                    # Isolated Redis logical database

# ─────────────────────────────────────────────────────────────────────────────
# Catalog bootstrap - one-time read-model backfill from Product Service
# Serving requests never query Product Service directly.
# ─────────────────────────────────────────────────────────────────────────────
PRODUCT_SERVICE_URL=http://localhost:3008     # Internal Product Service URL
INTERNAL_SERVICE_TOKEN=replace-with-private-token # Shared internal-call secret
CATALOG_BOOTSTRAP=false                       # Set true only when backfilling catalog
CATALOG_BOOTSTRAP_TIMEOUT_MS=10000            # Timeout for one catalog page request
CATALOG_BOOTSTRAP_RESET=false                 # Start from page 1 instead of checkpoint

# ─────────────────────────────────────────────────────────────────────────────
# Candidate intelligence and embedding pipeline
# Keep candidate flags false to preserve the current control behavior.
# ─────────────────────────────────────────────────────────────────────────────
CANDIDATE_PIPELINE_V3_ENABLED=false           # Master switch for advanced candidates
SEMANTIC_CANDIDATES_ENABLED=false             # Enable Qdrant semantic candidates
CO_BEHAVIOR_CANDIDATES_ENABLED=false          # Enable co-view/cart/purchase candidates

EMBEDDING_DISPATCHER_ENABLED=true             # Dispatch durable jobs to AI Service
EMBEDDING_DISPATCH_INTERVAL_MS=1000            # Poll interval for embedding jobs
EMBEDDING_DISPATCH_BATCH_SIZE=20               # Maximum jobs published per poll
EMBEDDING_JOB_LEASE_SECONDS=120                # Lease duration preventing duplicate dispatch
EMBEDDING_MODEL=text-embedding-3-small         # Provider model name
EMBEDDING_MODEL_VERSION=text-embedding-3-small # Version stored with every vector

QDRANT_URL=http://localhost:6333              # Qdrant HTTP endpoint
QDRANT_COLLECTION_ALIAS=recommendation_product_embeddings_current # Active alias
QDRANT_COLLECTION_VERSION=1                   # Physical collection version
QDRANT_VECTOR_SIZE=1536                        # Must match embedding dimensions
QDRANT_DISTANCE=Cosine                         # Cosine | Dot | Euclid
QDRANT_TIMEOUT_MS=500                          # Fail-soft request timeout

RELATION_CO_VIEW_WEIGHT=1                      # Weight for product view relation
RELATION_CO_CLICK_WEIGHT=2                     # Weight for product click relation
RELATION_CO_IMPRESSION_WEIGHT=0.05             # Low weight for passive impression
RELATION_CO_CART_WEIGHT=3                       # Weight for add-to-cart relation
RELATION_CO_PURCHASE_WEIGHT=6                   # Weight for completed purchase relation
RELATION_SCORE_HALF_LIFE_DAYS=30               # Relation score decay half-life

# ─────────────────────────────────────────────────────────────────────────────
# Profile signals and control ranking policy
# ─────────────────────────────────────────────────────────────────────────────
RECOMMENDATION_RULE_VERSION=control-ranking-v2 # Version returned for control ranking
RECOMMENDATION_PROFILE_HALF_LIFE_DAYS=7        # User preference decay half-life
RECOMMENDATION_WEIGHT_PRODUCT_IMPRESSED=0.05   # Passive impression signal
RECOMMENDATION_WEIGHT_PRODUCT_VIEWED=1         # Product view signal
RECOMMENDATION_WEIGHT_PRODUCT_CLICKED=2        # Product click signal
RECOMMENDATION_WEIGHT_SEARCH_PERFORMED=1.5     # Search signal
RECOMMENDATION_WEIGHT_PRODUCT_ADDED_TO_CART=4  # Add-to-cart signal
RECOMMENDATION_WEIGHT_PRODUCT_REMOVED_FROM_CART=-2 # Remove-from-cart signal

RECOMMENDATION_RANKING_WEIGHT_PROFILE_AFFINITY=0.35 # Long-term preference
RECOMMENDATION_RANKING_WEIGHT_SESSION_CONTEXT=0.2   # Current session intent
RECOMMENDATION_RANKING_WEIGHT_POPULARITY=0.15       # Trending/sales popularity
RECOMMENDATION_RANKING_WEIGHT_FRESHNESS=0.1         # New-product preference
RECOMMENDATION_RANKING_WEIGHT_QUALITY=0.1            # Rating/review/stock quality
RECOMMENDATION_RANKING_WEIGHT_EXPLORATION=0.1       # Discovery contribution

# ─────────────────────────────────────────────────────────────────────────────
# Hybrid ranking and deterministic experiment
# All flags are off by default; enable gradually after candidate data is ready.
# ─────────────────────────────────────────────────────────────────────────────
RECOMMENDATION_TRACKING_SECRET=change-me-in-production # Strong random secret in production
RANKING_PIPELINE_V4_ENABLED=false                # Master switch for hybrid ranking
HYBRID_RANKING_ENABLED=false                    # Enable hybrid feature scoring
RANKING_EXPERIMENT_ENABLED=false                # Enable CONTROL/HYBRID assignment
RANKING_EXPERIMENT_ID=recommendation-ranking-hybrid # Stable experiment name
RANKING_EXPERIMENT_TRAFFIC_PERCENT=0            # 0-100% actors assigned to treatment
RECOMMENDATION_RANKING_POLICY_VERSION=hybrid-ranking-v1 # Hybrid policy version

RECOMMENDATION_HYBRID_RANKING_WEIGHT_PROFILE_AFFINITY=0.25
RECOMMENDATION_HYBRID_RANKING_WEIGHT_SESSION_CONTEXT=0.18
RECOMMENDATION_HYBRID_RANKING_WEIGHT_SEMANTIC_SIMILARITY=0.15
RECOMMENDATION_HYBRID_RANKING_WEIGHT_CO_BEHAVIOR=0.1
RECOMMENDATION_HYBRID_RANKING_WEIGHT_POPULARITY=0.12
RECOMMENDATION_HYBRID_RANKING_WEIGHT_FRESHNESS=0.08
RECOMMENDATION_HYBRID_RANKING_WEIGHT_QUALITY=0.08
RECOMMENDATION_HYBRID_RANKING_WEIGHT_EXPLORATION=0.04

# Feature normalization scale for relation raw scores
RECOMMENDATION_RELATION_SCALE_CO_VIEW=1
RECOMMENDATION_RELATION_SCALE_CO_CART=3
RECOMMENDATION_RELATION_SCALE_CO_PURCHASE=6
